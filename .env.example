# Local API configuration only. Configure hosted database URLs and secrets in Vercel settings.
NODE_ENV=development
API_PORT=3000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/al_bassam_school

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=al_bassam_school

# Frontend Configuration
# Exact deployed web app origin; separate multiple allowed origins with commas.
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
REGISTRATION_SECRET=replace-with-a-long-random-secret
ALLOW_PUBLIC_REGISTRATION=false

# Logging
LOG_LEVEL=info

# Mistral AI Configuration (for chat functionality)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# API Key Authentication
# The API uses school-specific API keys for authentication.
# Each school gets a unique API key during registration.
# Include the API key in requests using the X-API-Key header.
# Example: curl -H "X-API-Key: sk-your-api-key" http://localhost:3000/api/students
